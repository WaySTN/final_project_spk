# ==============================================================================
# LaptopMatch — Environment Variables Example
# Salin berkas ini menjadi .env.local dan isi nilai sesuai proyek Supabase Anda.
# JANGAN PERNAH menyimpan kredensial asli atau service role key ke Git.
# ==============================================================================

# URL proyek Supabase (aman untuk publik/client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci publik/anon Supabase (aman untuk publik/client; dilindungi RLS di PostgreSQL)
# Catatan: dapat juga menggunakan NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY sesuai dashboard Supabase baru.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# KHUSUS SERVER & SKRIP CLI (mis. scripts/import-research.ts, provisioning admin).
# JANGAN PERNAH beri awalan NEXT_PUBLIC_ dan jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# URL dasar aplikasi (opsional, untuk tautan dan verifikasi origin CSRF)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode pengujian lokal terisolasi (HANYA untuk pengembangan/pengujian lokal tanpa Supabase aktif;
# jangan aktifkan di production — di production wajib menggunakan Supabase PostgreSQL + Auth + RLS)
# LAPTOPMATCH_LOCAL_STORE_PATH=
